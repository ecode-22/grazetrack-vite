DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.20
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:4173,http://192.168.1.20:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:4173,http://192.168.1.20:5173
DJANGO_COOKIE_SAMESITE=Lax
DJANGO_ADMIN_ENABLED=false
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email delivery, configure your SMTP provider:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=GrazingTrack <no-reply@example.com>

# Production: set DJANGO_DEBUG=false, a new strong DJANGO_SECRET_KEY,
# HTTPS FRONTEND_URL, exact HTTPS CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS.
# For a frontend hosted on a different site, set DJANGO_COOKIE_SAMESITE=None.
# SameSite=None is accepted only with secure cookies (HTTPS).
# Enable Django admin only when operationally required and protected separately.